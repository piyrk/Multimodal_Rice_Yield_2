        "r2": 0.8849,
        "nrmse_pct": 8.73
      },
      "Exp_E_Satellite_Weather": {
        "name": "Satellite + Weather",
        "model": "XGBoost",
        "modalities": ["satellite", "weather"],
        "num_features": 15,
        "mae": 0.5022,
        "rmse": 0.6579,
        "r2": 0.7195,
        "nrmse_pct": 13.63
      },
      "Exp_F_Biophysical_All": {
        "name": "Satellite + Weather + Soil",
        "model": "XGBoost",
        "modalities": ["satellite", "weather", "soil"],
        "num_features": 22,
        "mae": 0.3632,
        "rmse": 0.4696,
        "r2": 0.8571,
        "nrmse_pct": 9.73
      },
      "Exp_G_Full_Multimodal": {
        "name": "Full-feature XGBoost (+History)",
        "model": "XGBoost",
        "modalities": ["satellite", "weather", "soil", "historical"],
        "num_features": 26,
        "mae": 0.2014,
        "rmse": 0.2641,
        "r2": 0.9548,
        "nrmse_pct": 5.47
      }
    }
