{
  "feature_modality_ablation_xgboost": {
    "description": "Controlled feature-modality ablation using XGBoost regressor (evaluating feature combination predictive value for tabular ML)",
    "experiments": {
      "Exp_A_Weather_Only": {
        "name": "Weather Only",
        "model": "XGBoost",
        "modalities": ["weather"],
        "num_features": 10,
        "mae": 0.9132,
        "rmse": 1.1055,
        "r2": 0.2081,
        "nrmse_pct": 22.91
      },
      "Exp_B_Satellite_Only": {
        "name": "Satellite Only",
        "model": "XGBoost",
        "modalities": ["satellite"],
        "num_features": 5,
