        "rmse": 0.7025,
        "r2": 0.6802,
        "nrmse_pct": 14.56
      },
      "Exp_C_Soil_Only": {
        "name": "Soil Only",
        "model": "XGBoost",
        "modalities": ["soil"],
        "num_features": 7,
        "mae": 0.4073,
        "rmse": 0.5045,
        "r2": 0.8351,
        "nrmse_pct": 10.45
      },
      "Exp_D_Weather_Soil": {
        "name": "Weather + Soil",
        "model": "XGBoost",
        "modalities": ["weather", "soil"],
        "num_features": 17,
        "mae": 0.3368,
